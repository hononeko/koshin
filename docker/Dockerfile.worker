# syntax=docker/dockerfile:1

# Bytecode is platform-independent: build natively, even for a cross-platform image
FROM --platform=$BUILDPLATFORM eclipse-temurin:25.0.5_8-jdk-noble AS build
WORKDIR /src
# Build scripts first, so dependency resolution is cached until they change
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties .java-version ./
COPY gradle/ gradle/
COPY core/build.gradle.kts core/
COPY adapters/nats/build.gradle.kts adapters/nats/
COPY adapters/state-valkey/build.gradle.kts adapters/state-valkey/
COPY adapters/github-app/build.gradle.kts adapters/github-app/
COPY proxy/build.gradle.kts proxy/
COPY worker/build.gradle.kts worker/
COPY e2e/build.gradle.kts e2e/
RUN ./gradlew --no-daemon --quiet :worker:dependencies --configuration runtimeClasspath > /dev/null
COPY . .
RUN ./gradlew --no-daemon :worker:installDist

FROM eclipse-temurin:25.0.5_8-jre-noble
ARG VERSION=dev
LABEL org.opencontainers.image.title="koshin-worker" \
      org.opencontainers.image.source="https://github.com/hononeko/koshin" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}"

# No Renovate here: the pod's `renovate` container runs the upstream image, with the runner koshin-runner-init copies
# from this one (KSH-27).
COPY --from=build /src/worker/build/install/worker/lib/ /opt/koshin/lib/
COPY --chmod=755 docker/koshin-runner docker/koshin-runner-init /opt/koshin/bin/
# koshin-runner-init's default destination, owned by the runtime user so a new Compose volume mounted there is too
RUN install -d -o 12021 -g 0 /opt/koshin-dist

ENV RENOVATE_BASE_DIR=/tmp/renovate \
    KOSHIN_JAVA_OPTS="-Xmx256m -XX:+ExitOnOutOfMemoryError"
# Renovate's UID, so files in the volumes shared with the `renovate` container have a single owner
USER 12021:0
EXPOSE 8080
CMD ["/bin/sh", "-c", "exec java --enable-native-access=ALL-UNNAMED $KOSHIN_JAVA_OPTS -cp '/opt/koshin/lib/*' dev.hononeko.koshin.worker.ApplicationKt"]
