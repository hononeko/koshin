{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "koshin chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "profile": {
      "type": "string",
      "enum": [
        "minimal",
        "ha"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "github",
          "gitlab"
        ]
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "github": {
      "type": "object",
      "properties": {
        "apiUrl": {
          "type": "string"
        },
        "botLogin": {
          "type": "string"
        },
        "app": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "privateKeyKey": {
              "type": "string"
            },
            "privateKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gitlab": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "botLogin": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "renovateBotLogins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "http2Enabled": {
      "type": "boolean"
    },
    "natsSettings": {
      "type": "object",
      "properties": {
        "streamReplicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "ackWaitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxDeliver": {
          "type": "integer",
          "minimum": 1
        },
        "streamName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "valkeySettings": {
      "type": "object",
      "properties": {
        "keyPrefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^{}]+$"
        },
        "lockReplicaAckTimeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "commandTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "existingSecret": {
          "type": "string"
        },
        "secrets": {
          "type": "object",
          "properties": {
            "githubWebhookSecret": {
              "type": "string"
            },
            "gitlabWebhookSecret": {
              "type": "string"
            },
            "internalTriggerToken": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sweepRepositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(github|gitlab):.+/.+$"
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array"
            },
            "tls": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "httpRoute": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array"
            },
            "pathPrefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "existingSecret": {
          "type": "string"
        },
        "secrets": {
          "type": "object",
          "properties": {
            "githubToken": {
              "type": "string"
            },
            "gitlabToken": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "lockTtlSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "heartbeatIntervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "dirtyTtlSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "lockCollisionRetrySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "cliTimeoutMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 54
            },
            "renovateBinarySource": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rateLimits": {
          "type": "object",
          "properties": {
            "maxConcurrentRunsPerPlatform": {
              "type": "integer",
              "minimum": 1
            },
            "maxRequestsPerSecond": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "concurrentRequestLimit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "backoffBaseSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "backoffMaxSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxRequeues": {
              "type": "integer",
              "minimum": 0
            },
            "logPattern": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "repoCache": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "nats",
                "s3",
                "local"
              ]
            },
            "bucket": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "ttlDays": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "s3": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "pathStyle": {
                  "type": "boolean"
                },
                "existingSecret": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "renovateRedisUrl": {
          "type": "string"
        },
        "podDeletionCost": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 0
            },
            "maxReplicas": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pollingInterval": {
              "type": "integer",
              "minimum": 1
            },
            "scaleDownStabilizationSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "natsAccount": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceSizeLimit": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sweeper": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kedaNamespaceSelector": {
          "type": "object"
        },
        "proxyFrom": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "extraObjects": {
      "type": "array"
    },
    "externalNats": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "monitoringEndpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "externalValkey": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "sentinelPasswordSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sentinelUsername": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nats": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "valkey-cache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobProcessing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "platform": {
              "type": "string",
              "enum": [
                "github",
                "gitlab"
              ]
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
