{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hononeko/renovate-config",
    "github>hononeko/renovate-config:hononeko-actions",
    ":semanticCommitScope(deps)"
  ],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "timezone": "Europe/Chisinau",
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "automergeType": "pr",
  "platformAutomerge": true,
  "prHeader": "## 🤖 Renovate: Dependency Maintenance",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep worker.renovate.image.tag in charts/koshin/README.md in sync with values.yaml",
      "fileMatch": [
        "^charts/koshin/README\\.md$"
      ],
      "matchStrings": [
        "\\| worker\\.renovate\\.image\\.tag \\| string \\| `\"(?<currentValue>[^\"]+)\"` \\|"
      ],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Kotlin compiler, plugins, and official libraries",
      "matchPackageNames": [
        "org.jetbrains.kotlin*",
        "org.jetbrains.kotlinx*"
      ],
      "groupName": "Kotlin & Kotlinx"
    },
    {
      "description": "Group all Ktor server and client dependencies",
      "matchPackageNames": [
        "io.ktor*"
      ],
      "groupName": "Ktor"
    },
    {
      "description": "Group NATS client dependencies",
      "matchPackageNames": [
        "io.nats*"
      ],
      "groupName": "NATS"
    },
    {
      "description": "Group Lettuce and Valkey client dependencies",
      "matchPackageNames": [
        "io.lettuce*"
      ],
      "groupName": "Lettuce & Valkey"
    },
    {
      "description": "Group Detekt static analysis plugins and rules",
      "matchPackageNames": [
        "dev.detekt*",
        "io.gitlab.arturbosch.detekt*"
      ],
      "groupName": "Detekt"
    },
    {
      "description": "Group Testcontainers dependencies",
      "matchPackageNames": [
        "org.testcontainers*"
      ],
      "groupName": "Testcontainers"
    },
    {
      "description": "Group Gradle wrapper and Gradle GitHub actions",
      "matchPackageNames": [
        "gradle",
        "org.gradle*",
        "gradle/actions/**",
        "gradle/actions"
      ],
      "groupName": "Gradle"
    },
    {
      "description": "Group container base images",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "!ghcr.io/renovatebot/renovate"
      ],
      "groupName": "Docker Base Images"
    },
    {
      "description": "Group Helm chart dependencies",
      "matchManagers": [
        "helm-values",
        "helmv3",
        "helmfile"
      ],
      "matchPackageNames": [
        "!ghcr.io/renovatebot/renovate"
      ],
      "groupName": "Helm"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!gradle/actions/**",
        "!gradle/actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Renovate CLI in the worker's `renovate` container (chart, README, Kustomize, Compose): one weekly PR, automerged",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "groupName": "Renovate CLI",
      "schedule": [
        "before 5am on monday"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Renovate CLI majors are reviewed by hand",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
